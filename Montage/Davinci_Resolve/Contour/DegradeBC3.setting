				------------------------------------------------------------
				Input48 = InstanceInput { SourceOp = "Template", Source = "Enabled3", Name = "Activé", Default = 0, },
				Input49 = InstanceInput { SourceOp = "Template", Source = "Name3", Name = "Nom", DefaultText = "Black Shadow", },
				Input50 = InstanceInput { SourceOp = "Template", Source = "Opacity3", Name = "Opacité", Default = 1, },
