				Input2 = InstanceInput { SourceOp = "Template", Source = "Font", Name = "Police", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Template", Source = "Style", Name = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Template", Source = "Size", Name = "Taille", Default = 0.09, },
