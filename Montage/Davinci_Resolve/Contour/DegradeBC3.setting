				Input13 = InstanceInput { SourceOp = "Template", Source = "Overlap1", Name = "Fusion", Default = 2, },
				Input14 = InstanceInput { SourceOp = "Template", Source = "ElementShape1", Name = "Aspect", Default = 0, },
				Input16 = InstanceInput { SourceOp = "Template", Source = "JoinStyle1", Name = "Style join", Default = 1, },
				Input17 = InstanceInput { SourceOp = "Template", Source = "LineStyle1", Name = "Style Ligne", Default = 0, },
				Input18 = InstanceInput { SourceOp = "Template", Source = "Type1", Name = "Type", Default = 0, },

				-- Couleur élément 1
				Input19 = InstanceInput { SourceOp = "Template", Source = "Red1", Name = "Couleur", ControlGroup = 19, Default = 1, },
				Input20 = InstanceInput { SourceOp = "Template", Source = "Green1", ControlGroup = 19, Default = 1, },
				Input21 = InstanceInput { SourceOp = "Template", Source = "Blue1", ControlGroup = 19, Default = 1, },
