				Input6 = InstanceInput { SourceOp = "Template", Source = "HorizontalLeftCenterRight", Default = 0.0, },
				Input7 = InstanceInput { SourceOp = "Template", Source = "ShadingElements", Default = 1, },
				Input8 = InstanceInput { SourceOp = "Template", Source = "SelectElement", Default = 1, },
				Input9 = InstanceInput { SourceOp = "Template", Source = "Select", Default = 1, },

				------------------------------------------------------------
