				------------------------------------------------------------
				Input10 = InstanceInput { SourceOp = "Template", Source = "Enabled1", Name = "Activé", Default = 1, },
				Input11 = InstanceInput { SourceOp = "Template", Source = "Name1", Name = "Nom", DefaultText = "White Solid Fill", },
