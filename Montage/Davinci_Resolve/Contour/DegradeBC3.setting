				Input27 = InstanceInput { SourceOp = "Template", Source = "ShadingMappingAspect1", Name = "Mapping Ratio", Default = 1, },
				Input28 = InstanceInput { SourceOp = "Template", Source = "ShadingMappingLevel1", Name = "Mapping Niveau", Default = 4, },

				------------------------------------------------------------
				-- 🟥 PARTIE 3 : ÉLÉMENT 2 — OUTLINE (Red Outline)
				------------------------------------------------------------
				Input29 = InstanceInput { SourceOp = "Template", Source = "Enabled2", Name = "Activé", Default = 1, },
				Input30 = InstanceInput { SourceOp = "Template", Source = "Name2", Name = "Nom", DefaultText = "Red Outline", },
				Input31 = InstanceInput { SourceOp = "Template", Source = "Opacity2", Name = "Opacité", Default = 1, },
				Input32 = InstanceInput { SourceOp = "Template", Source = "Overlap2", Name = "Fusion", Default = 2, },
				Input33 = InstanceInput { SourceOp = "Template", Source = "ElementShape2", Name = "Aspect", Default = 1, },
				Input34 = InstanceInput { SourceOp = "Template", Source = "Thickness2", Name = "Épaisseur", Default = 0.1, },
				Input35 = InstanceInput { SourceOp = "Template", Source = "JoinStyle2", Name = "Style join", Default = 1, },
				Input36 = InstanceInput { SourceOp = "Template", Source = "LineStyle2", Name = "Style Ligne", Default = 0, },
				Input37 = InstanceInput { SourceOp = "Template", Source = "Type2", Name = "Type", Default = 1, },

				-- Couleur élément 2
				Input38 = InstanceInput { SourceOp = "Template", Source = "Red2", Name = "Couleur", ControlGroup = 38, Default = 1, },
				Input39 = InstanceInput { SourceOp = "Template", Source = "Green2", ControlGroup = 38, Default = 1, },
