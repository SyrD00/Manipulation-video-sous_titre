				-- Couleur élément 3
				Input57 = InstanceInput { SourceOp = "Template", Source = "Red3", Name = "Couleur", ControlGroup = 57, Default = 0, },
				Input58 = InstanceInput { SourceOp = "Template", Source = "Green3", ControlGroup = 57, Default = 0, },
				Input59 = InstanceInput { SourceOp = "Template", Source = "Blue3", ControlGroup = 57, Default = 0, },
