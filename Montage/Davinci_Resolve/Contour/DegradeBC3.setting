				Input66 = InstanceInput { SourceOp = "Template", Source = "ShadingMappingLevel3", Name = "Mapping Niveau", Default = 4, },

			},

			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Template",
					Source = "Output",
				}
			},

			ViewInfo = GroupInfo { Pos = { 0, 0 } },

			Tools = ordered() {
				Template = TextPlus {
					CtrlWZoom = false,
					Inputs = {

						--On definit ici les valeurs qu'on veut qu'il apparait dans davinci
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						Background = Input { Value = 0, },
						StyledText = Input { Value = " ♬ Custom Title ♬", },
						Font = Input { Value = "Meiryo UI", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.04, },
						VerticalTopCenterBottom = Input { Value =-25.5, },
						HorizontalLeftCenterRight = Input { Value =-0.03, },

						Enabled1 = Input { Value = 1, },
						Enabled2 = Input { Value = 1, },
						Enabled3 = Input { Value = 0, },

                        Thickness2 = Input { Value = 0.02, },
                        Type2 = Input { Value = 2, },

						-- ShadingGradients par défaut visibles
						ShadingGradient1 = Input { Value = Gradient { Colors = { [0] = { 1, 1, 1, 1 }, [1] = { 0, 0, 0, 1 } } } },
						ShadingGradient2 = Input {
							Value = Gradient {
								Colors = {
									[0.174] = { 0.6667, 0.3333, 1, 1 },
									[0.348] = { 0, 1, 1, 1 },
									[0.547] = { 0.0453, 0.7258, 1, 1 },
									[0.781] = { 0.153, 0.075, 1, 1 }
								}
